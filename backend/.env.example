# floppy.io — Python API のローカル設定
# このファイルを .env にコピーして使う（.env はコミットしない）

# --- MySQL ---
# 開発用の例。本番では必ず強いパスワードに変更する。
FLOPPY_DB_HOST=127.0.0.1
FLOPPY_DB_PORT=3306
FLOPPY_DB_NAME=floppy_io
FLOPPY_DB_USER=floppy
FLOPPY_DB_PASS=floppy

# --- アップロード ---
# 既定: backend/uploads
# FLOPPY_UPLOAD_DIR=/absolute/path/to/uploads

# --- セキュリティ ---
# API ドキュメント (/api/docs) は既定で無効。開発時のみ 1 にする。
FLOPPY_API_DOCS=1
# API トークンの有効期限 (日)。0 は無期限。本番は 30 を推奨。
FLOPPY_TOKEN_TTL_DAYS=30

# --- YouTube Data API (任意) ---
# FLOPPY_YOUTUBE_API_KEY=

# --- 埋め込み HTML / アップロード URL の絶対 URL (サブディレクトリ公開時に設定) ---
# アバター・画像・添付ファイルは /floppy.io/uploads/... として返されます。
# FLOPPY_PUBLIC_BASE_URL=https://fdd.wawa-app.me/floppy.io/

# --- CORS (開発時のみ。既定は *) ---
# FLOPPY_CORS_ORIGINS=http://localhost:3000
