<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  floppy.io — launchd (macOS) で API を常駐 + 自動再起動する

    mkdir -p /Users/it262148/floppy_io/backend/logs
    cp deploy/com.floppy.api.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.floppy.api.plist

  停止:  launchctl unload ~/Library/LaunchAgents/com.floppy.api.plist
  状態:  launchctl list | grep com.floppy.api
  ログ:  backend/logs/api.log

  ※ パスはこのマシン用です。別の環境へ持っていく場合は書き換えてください。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.floppy.api</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/it262148/floppy_io/backend/.venv/bin/uvicorn</string>
    <string>app.main:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8000</string>
    <string>--proxy-headers</string>
    <string>--forwarded-allow-ips</string>
    <string>127.0.0.1</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/it262148/floppy_io/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- ログイン時にも起動し、落ちたら自動で再起動する -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <key>StandardOutPath</key>
  <string>/Users/it262148/floppy_io/backend/logs/api.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/it262148/floppy_io/backend/logs/api.log</string>
</dict>
</plist>
